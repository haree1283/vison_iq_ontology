# ---- database ----
# DB_ENGINE: auto (MySQL when MYSQL_USER/MYSQL_PASSWORD are filled in, else SQLite), mysql, or sqlite
DB_ENGINE=auto
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=vision-iq
MYSQL_SSL=true
# SQLite file used when MySQL is not configured/reachable (default backend/data/visioniq.db)
# SQLITE_PATH=

# ---- server ----
PORT=8080
HOST=0.0.0.0
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated origins are supported. Use * only on a trusted private LAN.
FRONTEND_URL=http://localhost:5173
# Self-service sign up on the login page (new accounts get SIGNUP_ROLE); set false to disable
ALLOW_SIGNUP=true
SIGNUP_ROLE=user
# STREAM_REPLAY=true re-broadcasts stored records in random batches forever (the old demo 'live' feed); off by default
STREAM_REPLAY=false
# STREAM_INTERVAL=2500

ADMIN1_USERNAME=user1
ADMIN1_EMAIL=user1@example.com
ADMIN1_PASSWORD=change_this_password

ADMIN2_USERNAME=user2
ADMIN2_EMAIL=user2@example.com
ADMIN2_PASSWORD=change_this_password

# ---- Ollama (natural-language query parsing, optional) ----
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:1.5b

# ---- NH5 Highway website + models ----
NH5_ENABLED=true
# folder of the NH5 project (default: "../NH5 Highway" next to the VisionIQ folder)
# NH5_DIR=/path/to/NH5 Highway
# NH5_MODEL=/path/to/NH5 Highway/models/nh5_v8_final_ep100.pt
NH5_OCR_ENGINE=paddleocr
# seconds between imports of newly finished NH5 videos into the vehicle database
NH5_SYNC_INTERVAL=10
